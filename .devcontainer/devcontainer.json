{
  "name": "Ferret BCR-seq crashcourse",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "IGBLAST_HOME": "/opt/ncbi-igblast-1.21.0"
  },
  "postCreateCommand": "make verify",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
